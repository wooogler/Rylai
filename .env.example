# RYLAI Environment Variables Configuration
# Copy this file to .env.local for local development
# Copy this file to .env for Docker deployment

# ============================================
# DATABASE CONFIGURATION
# ============================================
# SQLite database file path (optional, defaults to ./data/rylai.db)
DATABASE_URL=./data/rylai.db

# ============================================
# AUTHENTICATION
# ============================================
# Secret used to sign the httpOnly session cookie. REQUIRED in production —
# generate a long random value, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-a-long-random-secret

# Passcode an educator enters at sign-up to create an admin (educator) account.
# Sign-ups without this passcode become learner accounts.
ADMIN_PASSCODE=rylai2025

# ============================================
# AI MODEL CONFIGURATION
# ============================================
# The predator chatbot is fixed to the VT Custom (StagePilot) endpoint and needs
# no API key. Educational feedback uses the OpenAI Responses API directly.

# OpenAI API Key (REQUIRED for feedback generation)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Feedback model (optional, defaults to gpt-5.5). Must be available to your key.
# FEEDBACK_MODEL=gpt-5.5

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Public URL of the deployment (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
